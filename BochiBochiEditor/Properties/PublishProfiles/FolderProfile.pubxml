<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の発行設定（dotnet publish BochiBochiEditor\BochiBochiEditor.csproj -p:PublishProfile=FolderProfile）。
  exe に dll・deps.json・runtimeconfig.json を内蔵する単一ファイル形式にし、配布フォルダの入口を
  「BochiBochiEditor.exe」と「resource」フォルダだけにする（settings.ini・error.log は実行時に exe の隣へ作られる）。
  .NET 8 デスクトップランタイムは同梱しない（framework-dependent）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- デバッグ情報は exe に埋め込み、pdb を配布フォルダに出さない -->
    <DebugType>embedded</DebugType>
    <PublishDir>..\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
  </PropertyGroup>
</Project>
