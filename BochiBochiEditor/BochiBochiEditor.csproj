<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BochiBochiEditor</AssemblyName>
    <RootNamespace>BochiBochiEditor</RootNamespace>
    <Product>BochiBochiEditor</Product>
    <Title>BochiBochiEditor</Title>
    <Company></Company>
    <Authors>C2H4</Authors>
    <ApplicationIcon>Bochi_icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- ビルドした exe・dll・pdb に作業フォルダのパス（PC のユーザー名など）を残さないよう、リポジトリの場所を置き換える -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))=.\</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <!-- 配布フォルダの入口を exe と resource だけにするため、補助ファイルは resource の下へ出力する -->
    <Content Include="Bochi_icon.ico">
      <Link>resource\Bochi_icon.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\img\**\*">
      <Link>resource\img\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\ini\**\*">
      <Link>resource\ini\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\txt\**\*">
      <Link>resource\txt\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

